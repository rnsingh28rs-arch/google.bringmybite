# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Google Gemini model used for AI Assistant recommendations.
# Defaults to "gemini-3.1-flash-lite" (Google's high-speed, cost-efficient 3.1 Flash Lite model).
GEMINI_MODEL="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONTACT ENQUIRY DELIVERY CONFIGURATION
# Configure AT LEAST ONE delivery method for live production forwarding:
#
# Option 1: Resend (Recommended for Vercel Serverless)
# Sign up at https://resend.com and generate an API key
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# CONTACT_TO_EMAIL="28r.n.singh@gmail.com"  # defaults to this address if unset
# ADMIN_EMAIL="28r.n.singh@gmail.com"
# Optional Gmail API autoconnect (server-side OAuth; never expose these values with a VITE_ prefix)
# Create a Google OAuth Web application, enable Gmail API, and add this exact redirect URI:
# https://YOUR_DEPLOYMENT_HOST/api/gmail/oauth
# GMAIL_OAUTH_CLIENT_ID="your-google-oauth-client-id"
# GMAIL_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
# GMAIL_REDIRECT_URI="https://YOUR_DEPLOYMENT_HOST/api/gmail/oauth"
# GMAIL_OAUTH_STATE_SECRET="generate-at-least-32-random-characters"
# Generate a 32-byte key and base64-encode it for AES-256-GCM token encryption:
# GMAIL_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# SUPABASE_SERVICE_ROLE_KEY="server-side-service-role-key"
# ADMIN_EMAIL="28r.n.singh@gmail.com"

# CONTACT_FROM_EMAIL: Note that transactional email providers (e.g., Resend) do NOT permit sending
# directly from public @gmail.com addresses due to strict SPF and DMARC (p=reject) policies.
# For sandbox testing, use Resend's default verified identity: "Google Tool Finder <onboarding@resend.dev>"
# For production, verify your custom domain in Resend DNS (DKIM/SPF) and set your verified sender:
# CONTACT_FROM_EMAIL="Google Tool Finder <notifications@your-verified-domain.com>"
#
# Option 2: Webhook Forwarding (Slack / Discord / Custom endpoint)
# CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/..."
#
# Option 3: Local / Staging Test Mode (Accepts & validates submissions without live dispatch)
# CONTACT_TEST_MODE="true"

# ADMIN AUTHENTICATION
# Set a strong password for administrative access to the Monetization Console (/admin).
# If unset, the /admin endpoint will fail closed with 503 ADMIN_AUTH_UNCONFIGURED.
# ADMIN_PASSWORD="replace-with-a-long-random-admin-passphrase"

# DURABLE DATABASE & PERSISTENCE CONFIGURATION (OPTIONAL FOR PRODUCTION)
# By default, local JSON files in data/ are used. For durable Vercel serverless persistence:
#
# Option A: Supabase PostgreSQL (Recommended)
# Run data/schema.sql in your Supabase SQL editor:
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
#
# Option B: Vercel KV / Upstash Redis
# KV_REST_API_URL="https://your-kv-store.upstash.io"
# KV_REST_API_TOKEN="your-kv-token"

# GOOGLE AUTHENTICATION (OPTIONAL - PRODUCTION UPGRADE)
# When unset, built-in verified developer sign-in flow is active for member stack testing:
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# FIREBASE_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"..."}'

